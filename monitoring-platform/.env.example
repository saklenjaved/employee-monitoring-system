# Copy this file to .env and fill in your own values. Never commit the real .env file.
# The file is read at startup. Variables already set in the real environment win over it.

# Database password for the local PostgreSQL container (docker-compose.yml).
DB_PASSWORD=change-me

# Local email through Gmail SMTP. Use a Gmail "App Password" (16 characters, needs 2-step verification),
# not your normal Gmail password. Create one at https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=your.address@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
# Gmail sends from the signed-in address, so use the same address here.
DEFAULT_FROM_EMAIL=your.address@gmail.com

# Email over HTTPS (needed on Render Free, which blocks SMTP). When set, it is used instead of EMAIL_HOST.
# DEFAULT_FROM_EMAIL must then be a sender verified in your Brevo account.
# BREVO_API_KEY=

# Local development only. DJANGO_DEBUG=1 turns on development settings (never on a real server).
DJANGO_DEBUG=1
# Local demo database, built by scripts/setup_local.ps1. Leave it out to use db.sqlite3 (the real one).
SQLITE_PATH=demo.sqlite3
